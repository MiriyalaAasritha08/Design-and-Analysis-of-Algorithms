#include <stdio.h> 

int main() 

{ 

    int a[100], n, k, i, j; 

    int min, pos; 

printf("Enter number of elements: "); 

scanf("%d", &n); 

printf("Enter elements:\n "); 

for(i = 0; i < n; i++){ 

 scanf("%d", &a[i]); 

} 

printf("Enter k: "); 

scanf("%d", &k); 

for(i = 0; i < k; i++) 

    { 

        min = a[i]; 

        pos = i; 

 for(j = i + 1; j < n; j++) 

        { 

            if(a[j] < min) 

            { 

                min = a[j]; 

                pos = j; 

            } 

        } 

a[pos] = a[i]; 

a[i] = min; 

    } 

printf("The %d smallest element = %d",k, a[k - 1]); 

return 0; 

} 
