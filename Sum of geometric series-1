#include <stdio.h> 
#include <math.h> 

int main() 
{ 
  int a, r, n; 
  float sum; 

printf("Enter first term: "); 
scanf("%d", &a); 

printf("Enter common ratio: "); 
scanf("%d", &r); 

printf("Enter number of terms: "); 
scanf("%d", &n); 

sum = a * (pow(r, n) - 1) / (r - 1); 

printf("Sum = %.0f", sum); 

return 0; 

} 
