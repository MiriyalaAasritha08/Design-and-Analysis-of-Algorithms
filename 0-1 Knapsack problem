#include <stdio.h>
int max(int a, int b)
{
    return (a > b) ? a : b;
}

int main()
{
    int n, W;

    printf("Enter number of items: ");
    scanf("%d", &n);

    int p[n + 1], w[n + 1];

    printf("Enter profits:\n");
    for (int i = 1; i <= n; i++)
        scanf("%d", &p[i]);

    printf("Enter weights:\n");
    for (int i = 1; i <= n; i++)
        scanf("%d", &w[i]);

    printf("Enter capacity: ");
    scanf("%d", &W);

    int V[n + 1][W + 1];

    for (int i = 0; i <= n; i++)
    {
        for (int j = 0; j <= W; j++)
        {
            if (i == 0 || j == 0)
                V[i][j] = 0;

            else if (w[i] > j)
                V[i][j] = V[i - 1][j];

            else
                V[i][j] = max(V[i - 1][j],
                    p[i] + V[i - 1][j - w[i]]);
        }
    }

    printf("Maximum Profit = %d\n", V[n][W]);

    return 0;
}
