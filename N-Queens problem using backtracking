
#include <stdio.h>

int board[20][20], n;

int isSafe(int row, int col)
{
    int i, j;

    for (i = 0; i < row; i++)
        if (board[i][col] == 1)
            return 0;

    for (i = row-1, j = col-1; i >= 0 && j >= 0; i--, j--)
        if (board[i][j] == 1)
            return 0;

    for (i = row-1, j = col+1; i >= 0 && j < n; i--, j++)
        if (board[i][j] == 1)
            return 0;

    return 1;
}

int solve(int row)
{
    int col;

    if (row == n)
        return 1;

    for (col = 0; col < n; col++)
    {
        if (isSafe(row, col))
        {
            board[row][col] = 1;

            if (solve(row + 1))
                return 1;

            board[row][col] = 0;
        }
    }

    return 0;
}

int main()
{
    int i, j;

    printf("Enter N: ");
    scanf("%d", &n);

    if (n < 1 || n > 20)
    {
        printf("Invalid Input");
        return 0;
    }

    if (solve(0))
    {
        printf("Solution Exists\n");

        for (i = 0; i < n; i++)
        {
            for (j = 0; j < n; j++)
                printf("%d ", board[i][j]);

            printf("\n");
        }
    }
    else
    {
        printf("Solution Does Not Exist");
    }

    return 0;
}
