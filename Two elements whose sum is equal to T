#include <stdio.h> 
#define SIZE 100 

int main() 
{ 
    int a[SIZE], hash[SIZE] = {0}; 
    int n, T, i, complement; 
  
    printf("Enter the number of elements: "); 
    scanf("%d", &n); 

    printf("Enter the elements:\n"); 
    for (i = 0; i < n; i++) 
    { 
        scanf("%d", &a[i]); 
    } 

    printf("Enter the target value T: "); 
    scanf("%d", &T); 

    for (i = 0; i < n; i++) 
    { 
        complement = T - a[i]; 
    if (complement >= 0 && complement < SIZE && hash[complement] > 0) 
    { 
        printf("Pair found: %d + %d = %d\n",complement, a[i], T); 
        return 0; 
    } 
    if (a[i] >= 0 && a[i] < SIZE) 
        hash[a[i]]++; 
    }   
    printf("No pair found.\n"); 
    return 0; 
} 
