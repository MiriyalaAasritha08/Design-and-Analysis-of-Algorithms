#include <stdio.h>

int main()
{
    int size, n, key, index, i, pos;

    printf("Enter hash table size: ");
    scanf("%d", &size);

    int hashTable[size];

    for(i = 0; i < size; i++)
    {
        hashTable[i] = -1;
    }

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for(i = 0; i < n; i++)
    {
        scanf("%d", &key);

        index = key % size;

        for(int j = 0; j < size; j++)
        {
            pos = (index + j * j) % size;

            if(hashTable[pos] == -1)
            {
                hashTable[pos] = key;

                printf("%d inserted at index %d\n", key, pos);

                break;
            }
        }
    }
    printf("\nQuadratic Probing Hash Table:\n");

    for(i = 0; i < size; i++)
    {
        if(hashTable[i] == -1)
        {
            printf("Index %d : Empty\n", i);
        }
        else
        {
            printf("Index %d : %d\n", i, hashTable[i]);
        }
    }

    return 0;
}
