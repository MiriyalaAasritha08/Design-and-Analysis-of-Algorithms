#include <stdio.h> 

int main() 
{ 
    int n, cost[10][10], visited[10] = {0}; 
    int i, j, u, v, min, total = 0; 

    printf("Enter number of vertices: "); 
    scanf("%d", &n); 

    printf("Enter cost adjacency matrix:\n"); 

    for (i = 0; i < n; i++) 
        for (j = 0; j < n; j++) 
            scanf("%d", &cost[i][j]); 
            
    visited[0] = 1; 

    printf("\nMinimum Spanning Tree:\n"); 
    for (int k = 0; k < n - 1; k++) 
    { 

        min = 9999; 
        for (i = 0; i < n; i++) 
        { 
            if (visited[i]) 
            { 
                for (j = 0; j < n; j++) 
                { 
                    if (!visited[j] && cost[i][j] != 0 && 
                        cost[i][j] < min) 
                    { 
                        min = cost[i][j]; 
                        u = i; 
                        v = j; 
                    } 
                } 
            } 
        } 
        printf("%d - %d = %d\n", u, v, min); 
        total += min; 
        visited[v] = 1; 
    } 
    printf("Minimum Cost = %d\n", total); 
    return 0; 
} 
