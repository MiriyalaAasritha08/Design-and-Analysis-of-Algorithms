#include <stdio.h>

struct Item
{
    int object;
    int weight;
    int profit;
    float ratio;
};

int main()
{
    int n, capacity, i, j;
    float totalProfit = 0;

    printf("Enter number of objects: ");
    scanf("%d", &n);

    struct Item item[n];

    printf("Enter object number, weight and profit:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d %d %d",
              &item[i].object,
              &item[i].weight,
              &item[i].profit);

        item[i].ratio = (float)item[i].profit / item[i].weight;
    }

    printf("Enter knapsack capacity: ");
    scanf("%d", &capacity);

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (item[i].ratio < item[j].ratio)
            {
                struct Item temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }

    for (i = 0; i < n; i++)
    {
        if (capacity >= item[i].weight)
        {
            capacity -= item[i].weight;
            totalProfit += item[i].profit;

            printf("Object %d taken completely\n",
                   item[i].object);
        }
        else
        {
            printf("Fraction of object %d taken\n",
                   item[i].object);

            totalProfit += item[i].ratio * capacity;
            break;
        }
    }

    printf("Maximum Profit = %.2f\n", totalProfit);

    return 0;
}
