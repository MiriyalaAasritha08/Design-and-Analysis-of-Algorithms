#include <stdio.h>

struct Item
{
    int weight;
    int profit;
    float ratio;
};

int main()
{
    struct Item item[100], temp;
    int n, capacity;
    int i, j;
    float totalProfit = 0;
    int remaining;

    printf("Enter the number of items: ");
    scanf("%d", &n);

    printf("Enter the knapsack capacity: ");
    scanf("%d", &capacity);

    for (i = 0; i < n; i++)
    {
        printf("Enter weight and profit of item %d: ", i + 1);
        scanf("%d %d", &item[i].weight, &item[i].profit);

        item[i].ratio =
            (float)item[i].profit / item[i].weight;
    }

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (item[i].ratio < item[j].ratio)
            {
                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }

    remaining = capacity;

    printf("\nItems selected:\n");

    for (i = 0; i < n; i++)
    {
        if (item[i].weight <= remaining)
        {
            printf("Item %d: 100%%\n", i + 1);

            totalProfit += item[i].profit;
            remaining -= item[i].weight;
        }
        else
        {
            float fraction = (float)remaining / item[i].weight;

            printf("Item %d: %.2f%%\n", i + 1, fraction * 100);

            totalProfit += item[i].profit * fraction;
            remaining = 0;

            break;
        }
    }

    printf("\nMaximum Profit = %.2f\n", totalProfit);

    return 0;
}
